{
 "openapi": "3.1.0",
 "info": {
  "title": "Naadi API",
  "description": "Delhi bus travel-time model and journey planner built on the Delhi Transport Stack. Times come from 31 days of real bus GPS (Oct 2026) plus a live nowcast. Bus data: Delhi Transport Stack (delhi.transportstack.in) and Delhi Open Transit Data (Department of Transport, GNCTD; IIIT-Delhi). Map data: OpenStreetMap contributors.",
  "version": "1.0"
 },
