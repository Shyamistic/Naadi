     },
     {
      "name": "depart",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "'now' (default) or ISO time in IST, e.g. 2026-11-17T08:30",
       "title": "Depart"
      },
      "description": "'now' (default) or ISO time in IST, e.g. 2026-11-17T08:30"
     },
     {
      "name": "options",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 5,
       "minimum": 1,
       "default": 3,
       "title": "Options"
      }
