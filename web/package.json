{
  "name": "naadi-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "test": "vitest run --exclude e2e/**",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "screens": "playwright test -c playwright.screens.config.ts",
    "fixtures": "node e2e/fixtures/capture.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.108.0",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
